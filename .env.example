# Browser-visible settings (Vite exposes only VITE_* variables).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPPORT_EMAIL=your-real-support-address@example.com

# Server-only Netlify Function settings. Set these in Netlify; do not put real
# values in a Vite .env file committed to source control.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_PREMIUM_PRICE_ID=price_id_for_breezier_days_premium
STRIPE_WEBHOOK_SECRET=whsec_from_the_stripe_webhook_endpoint
APP_ORIGIN=https://your-production-domain.example
